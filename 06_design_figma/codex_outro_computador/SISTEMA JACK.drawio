        <mxCell id="auth" value="1. AUTENTICAÇÃO&lt;br&gt;&lt;br&gt;• Tela de login&lt;br&gt;• E-mail / telefone&lt;br&gt;• Senha&lt;br&gt;• Entrar&lt;br&gt;• Recuperar senha&lt;br&gt;• Criar conta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#168C84;fontSize=15;spacing=12" vertex="1" parent="1"><mxGeometry x="50" y="180" width="230" height="190" as="geometry"/></mxCell>
        <mxCell id="home" value="2. HOME / DASHBOARD&lt;br&gt;&lt;br&gt;• Header e busca&lt;br&gt;• Banner promocional&lt;br&gt;• Categorias&lt;br&gt;• Produtos em destaque&lt;br&gt;• Navegação inferior&lt;br&gt;• Home · Busca · Pedidos · Perfil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#2475C5;fontSize=15;spacing=12" vertex="1" parent="1"><mxGeometry x="360" y="180" width="250" height="210" as="geometry"/></mxCell>
        <mxCell id="catalog" value="3. CATÁLOGO / BUSCA&lt;br&gt;&lt;br&gt;• Lista de produtos&lt;br&gt;• Filtros e categorias&lt;br&gt;• Ordenação&lt;br&gt;• Cards com imagem, nome e preço&lt;br&gt;• Acesso ao detalhe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2ECFF;strokeColor=#7856B8;fontSize=15;spacing=12" vertex="1" parent="1"><mxGeometry x="700" y="180" width="240" height="190" as="geometry"/></mxCell>
        <mxCell id="detail" value="4. DETALHE DO PRODUTO&lt;br&gt;&lt;br&gt;• Galeria / imagem&lt;br&gt;• Nome e descrição&lt;br&gt;• Preço e promoção&lt;br&gt;• Variações / quantidade&lt;br&gt;• Adicionar ao carrinho" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#D46B2C;fontSize=15;spacing=12" vertex="1" parent="1"><mxGeometry x="1030" y="180" width="250" height="190" as="geometry"/></mxCell>
        <mxCell id="cart" value="5. CARRINHO&lt;br&gt;&lt;br&gt;• Itens selecionados&lt;br&gt;• Quantidade e subtotal&lt;br&gt;• Cupom / desconto&lt;br&gt;• Total da compra&lt;br&gt;• Ir para checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#D39B2D;fontSize=15;spacing=12" vertex="1" parent="1"><mxGeometry x="1030" y="470" width="250" height="180" as="geometry"/></mxCell>
        <mxCell id="checkout" value="6. CHECKOUT / PAGAMENTO&lt;br&gt;&lt;br&gt;• Endereço de entrega&lt;br&gt;• Forma de pagamento&lt;br&gt;• Resumo do pedido&lt;br&gt;• Frete / prazo&lt;br&gt;• Confirmar pedido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7E8;strokeColor=#4A9B45;fontSize=15;spacing=12" vertex="1" parent="1"><mxGeometry x="700" y="470" width="240" height="180" as="geometry"/></mxCell>
        <mxCell id="orders" value="7. PEDIDOS / ACOMPANHAMENTO&lt;br&gt;&lt;br&gt;• Lista de pedidos&lt;br&gt;• Status do pedido&lt;br&gt;• Detalhes e itens&lt;br&gt;• Entrega / rastreio&lt;br&gt;• Histórico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#2475C5;fontSize=15;spacing=12" vertex="1" parent="1"><mxGeometry x="360" y="470" width="250" height="180" as="geometry"/></mxCell>
